# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# DuckDB — binary database file, reproduced by running the load script
*.duckdb
*.duckdb.wal

# dbt
dbt_mtpl/target/
dbt_mtpl/logs/
dbt_mtpl/.user.yml
logs/

# Dagster
# dagster_home/ holds instance config (dagster.yaml — committed) and runtime
# state (SQLite run history, schedule db, compute logs — NOT committed).
# Ignore the runtime subdirectories individually so dagster.yaml stays tracked.
dagster_mtpl/dagster_home/history/
dagster_mtpl/dagster_home/schedules/
dagster_mtpl/dagster_home/storage/
dagster_mtpl/dagster_home/.nux/
dagster_mtpl/dagster_home/.telemetry/
dagster_mtpl/.tmp_dagster_home_*/
dagster_mtpl/storage/
dagster_mtpl/logs/
dagster_mtpl/.dagster/

# macOS
.DS_Store
.AppleDouble

# Editors
.vscode/settings.json
*.swp
*.swo

# Secrets / environment
.env
*.env.*

# Data — raw CSVs are large; exports are reproducible from the pipeline
data/raw/
# Keep data/exports/ tracked so dashboard CSVs are versioned in the repo
